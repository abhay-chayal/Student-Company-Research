{
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/fix",
      "destination": "/fix.html"
    },
    {
      "source": "/mentor",
      "destination": "/mentor.html"
    }
  ],
  "installCommand": "npm install --omit=dev"
}
